rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all: Close everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.id is string &&
        data.id == request.auth.uid &&
        data.email is string &&
        data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('themePreference' in data) || (data.themePreference in ['dark', 'light', 'system'])) &&
        (!('notificationPreferences' in data) || data.notificationPreferences is map) &&
        (!('businessIdentity' in data) || data.businessIdentity is map) &&
        (!('taxProfile' in data) || data.taxProfile is map);
    }

    function isValidChatMessage(data) {
      return data.keys().hasOnly(['id', 'userId', 'sender', 'text', 'timestamp', 'sources']) &&
        data.id is string &&
        data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.sender in ['user', 'lex'] &&
        data.text is string && data.text.size() > 0 && data.text.size() <= 10000 &&
        data.timestamp is string && data.timestamp.size() <= 64 &&
        (!('sources' in data) || data.sources is list);
    }

    // User profile and settings
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow list: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming());
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);

      // Subcollection: Chat messages with AI Lex
      match /chat_messages/{messageId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(messageId) && isValidChatMessage(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(messageId) && isValidChatMessage(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(messageId);
      }
    }
  }
}
